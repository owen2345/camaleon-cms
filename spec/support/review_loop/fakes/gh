#!/usr/bin/env bash
# The fake gh of the review-loop script specs (answer.sh). The answer "fail" exits with 1 and prints nothing.
# The answer "fail:<message>" prints the message to the error output and exits with 1. Any other answer is
# the output of gh, which the fake filters with jq when the call has a --jq argument, as gh does.
. "$(dirname "$0")/answer.sh"
case "$answer" in
  fail) exit 1 ;;
  fail:*) printf '%s\n' "${answer#fail:}" >&2; exit 1 ;;
esac
filter=
while [ $# -gt 0 ]; do
  if [ "$1" = --jq ]; then filter=$2; shift; fi
  shift
done
if [ -n "$filter" ]; then printf '%s\n' "$answer" | jq -r "$filter"; else printf '%s\n' "$answer"; fi
