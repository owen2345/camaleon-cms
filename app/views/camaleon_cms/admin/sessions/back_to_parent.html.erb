<div class="login-body">
    <h3 class="login-box-msg"><%= t('camaleon_cms.admin.login.back_to_parent.title', default: 'Return to your account') %></h3>
    <%= render "camaleon_cms/flash_messages" %>
    <p>
        <%# The parent admin's username is deliberately not shown: whoever holds an abandoned
            impersonation must not learn which admin account to attack (or phish). %>
        <%= t('camaleon_cms.admin.login.back_to_parent.instructions',
              default: 'You are currently working as %{impersonated}. Enter the password for your own account to return to it, or log out completely.',
              impersonated: @impersonated_user.username) %>
    </p>
    <%= form_tag cama_admin_back_to_parent_path, method: "post", role: "form", id: "back_to_parent", class: "form-horizontal cama_form_validate" do %>
        <div class="form-group">
            <div class="col-md-12">
                <%= password_field_tag :password, nil, class: "form-control required", autofocus: true,
                                       placeholder: t('camaleon_cms.admin.login.password', default: 'Password') %>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-12">
                <%= raw cama_captcha_tags_if_under_attack("login") %>
            </div>
        </div>
    <% end %>
    <%# Security (audit M6): the full-logout button is its OWN button_to form, a sibling of the
        re-auth form above -- never nested inside it. A nested <form> is dropped by the HTML parser
        (the button would submit the outer form), and with per-form CSRF tokens the two tokens would
        collide, breaking both submits. The "Return to my account" button stays a submit of the
        re-auth form via the HTML5 `form` attribute. %>
    <div class="row">
        <div class="col-xs-6">
            <%= button_to t('camaleon_cms.admin.login.back_to_parent.logout', default: 'Log out completely'),
                          cama_admin_logout_path(full: 1), method: :post,
                          class: 'btn btn-default btn-block btn-flat' %>
        </div>
        <div class="col-xs-6">
            <button type="submit" form="back_to_parent" class="btn btn-primary btn-block btn-flat"><%= t('camaleon_cms.admin.login.back_to_parent.submit', default: 'Return to my account') %></button>
        </div>
    </div>
</div>
